{
    "name": "you/mailerlite-export",
    "description": "CLI tool to export MailerLite subscribers (email, names, all custom fields) to CSV",
    "type": "project",
    "require": {
        "php": ">=7.4",
        "mailerlite/mailerlite-php": "^1.0",
        "php-http/curl-client": "^2.3",
        "guzzlehttp/psr7": "^2.6",
        "php-http/message": "^1.16",
        "symfony/http-client": "^8.1"
    },
    "autoload": {
        "psr-4": {
            "App\\": "src/"
        }
    },
    "config": {
        "allow-plugins": {
            "php-http/discovery": true
        }
    }
}
